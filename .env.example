# Copy to .env for local testing with `netlify dev`. Never commit real keys.
# In production, set these in Netlify → Site configuration → Environment variables.

# Flutterwave secret key (Dashboard → Settings → API keys). Use the TEST key until launch.
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Any long random string. Enter the SAME value in Flutterwave → Settings → Webhooks → Secret hash.
FLW_SECRET_HASH=replace-with-a-long-random-string

# --- Ticket emails and QR codes ---

# Resend (https://resend.com) API key, and a sender on a domain you've verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
TICKET_EMAIL_FROM=Creators Hub <tickets@your-domain.com>

# Passcode door staff enter on their phones to check tickets in. Make it long.
CHECKIN_PIN=choose-a-long-passcode

# Private inbox that gets a copy of every paid order. Set it only in Netlify's
# environment settings, never in this file or in code. Leave empty to turn off.
NOTIFY_EMAIL=
