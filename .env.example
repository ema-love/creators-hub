# Copy to .env for local testing with `netlify dev`. Never commit real values.
# In production, set these in Netlify → Site configuration → Environment variables.

# --- Registration ---
# Total places for The First Room. A number, empty for no limit, or 0 to close registration.
EVENT_CAPACITY=

# Passcode door staff enter on their phones to check tickets in. Make it long.
CHECKIN_PIN=choose-a-long-passcode

# --- Confirmation emails (needs a domain verified in Resend) ---
# Resend (https://resend.com) API key, and a sender on that domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
TICKET_EMAIL_FROM=Creators Hub <tickets@your-domain.com>

# --- Google Sheet (see integrations/google-sheets/README.md) ---
# The sheet's Apps Script web-app URL and the connection key it shows. Leave empty to turn off.
GOOGLE_SHEET_URL=
GOOGLE_SHEET_KEY=

# --- Google Search Console ---
# The verification code from Search Console's "HTML tag" method (or the whole tag). Redeploy after setting.
GOOGLE_SITE_VERIFICATION=
